{% liquid
    assign section_st = section.settings
    assign section_width = section_st.section_width
    assign color_scheme = section_st.color_scheme
    assign section_pt = section_st.section_pt
    assign section_pb = section_st.section_pb
    assign heading = section_st.heading
    assign subheading = section_st.subheading
    assign reset_spacing = section_st.reset_spacing
    if reset_spacing
    assign reset_spacing = 'mb-0'
    else
    assign reset_spacing = 'section__spacing-sections'
    endif
%}

<section 
    class="section__py color-{{ color_scheme }} gradient {{ reset_spacing }}"
    style="--section-pt: {{ section_pt }}; --section-pb: {{ section_pb }};"
>
    <div class="{{ section_width }}">
        {% if heading != blank or subheading != blank %}
            <div class="section__header" style="margin-bottom: calc(1.4228rem + 1.3423vw);">
                {% render 'header', section: section %}
            </div>
        {% endif %}
   
        <div>
            {% for block in section.blocks %}
                {%- liquid
                    assign block_st = block.settings
                -%}
                    <collapse-block class="bor-bot bor-1" style="border-color: #dbdbdb; line-height: 2.5;">
                        <collapse-toggle class="d-flex ai-center jc-between pointer" style="font-weight: 500;">
                            <span>{{ block_st.faq_question }}</span>
                            <collapse-icon>+</collapse-icon>
                        </collapse-toggle>
                        <collapse-content>
                           {{ block_st.faq_answer |  replace: '<p>', '<p style="line-height: 2;">' }}
                        </collapse-content>
                    </collapse-block>
            {% endfor %}
        </div>
    </div>
</section>

{% schema %}
{
    "name": "FAQ",
    "tag": "section",
    "settings": [
        {
            "type": "select",
            "id": "section_width",
            "label": "Section width",
            "default": "defaul",
            "options": [
                {
                    "value": "defaul",
                    "label": "Defaul"
                },
                {
                    "value": "fluid-container",
                    "label": "Fluid Container"
                },
                {
                    "value": "stretch-width",
                    "label": "Stretch Width"
                },
                {
                    "value": "full-width",
                    "label": "Full Width"
                }
            ]
        },
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Section color",
            "default": "scheme-1"
        },
        {
            "type": "header",
            "content": "Header"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading"
        },
        {
            "type": "richtext",
            "id": "subheading",
            "label": "Subheading"
        },
        {
            "type": "select",
            "id": "header_size",
            "label": "Header size",
            "default": "medium",
            "options": [
                {
                    "value": "small",
                    "label": "Small"
                },
                {
                    "value": "medium",
                    "label": "Medium"
                },
                {
                    "value": "large",
                    "label": "Large"
                }
            ]
        },
        {
            "type": "select",
            "id": "txt_align",
            "label": "Text Align",
            "default": "center",
            "options": [
                {
                    "value": "left",
                    "label": "Left"
                },
                {
                    "value": "center",
                    "label": "Center"
                },
                {
                    "value": "right",
                    "label": "Right"
                }
            ]
        },
        {
            "type": "checkbox",
            "id": "reverse_content",
            "label": "Reverse content order",
            "default": false,
            "visible_if": "{{ section.settings.heading != blank and section.settings.subheading != blank }}"
        },
        {
            "type": "header",
            "content": "Section Padding"
        },
        {
            "type": "range",
            "id": "section_pt",
            "label": "Top",
            "default": 50,
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px"
        },
        {
            "type": "range",
            "id": "section_pb",
            "label": "Bottom",
            "default": 50,
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px"
        },
        {
            "type": "checkbox",
            "id": "reset_spacing",
            "label": "Remove default space between sections",
            "default": false
        }
    ],
    "blocks": [
        {
            "type": "faq-content",
            "name": "FAQ Content",
            "settings": [
                {
                    "type": "text",
                    "id": "faq_question",
                    "label": "FAQ Question",
                    "default": "Frequently Asked Questions?"
                },
                {
                    "type": "richtext",
                    "id": "faq_answer",
                    "label": "FAQ Answer",
                    "default": "<p>Lorem ipsum dolor sit amet conse ctetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore.</p>"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "FAQ",
            "blocks": [
                {
                    "type": "faq-content"
                },
                {
                    "type": "faq-content"
                },
                {
                    "type": "faq-content"
                }
            ]
        }
    ]
}
{% endschema %}
