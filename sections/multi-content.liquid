{% liquid
  assign section_st = section.settings
  assign block_first_child = section.blocks.size | modulo: 2
%}

{% capture style %}
    --section-pt: {{ section_st.section_pt }}; --section-pb: {{ section_st.section_pb }};
{% endcapture %}

{% if block_first_child == 1 %}
  {% style %}
    @media (min-width: 576px) and (max-width: 767.98px) {
        #shopify-section-{{ section.id }} .content__multi-content > div:first-of-type {
            flex: 0 0 100%;
        }
    }
  {% endstyle %}
{% endif %}

<section
  class="section__multi-content section__py color-{{ section_st.color_scheme }} gradient"
  style="{{ style | strip }}"
>
  <div class="{{ section_st.section_width }}">
    {% if section_st.heading != blank or section_st.subheading != blank %}
      <div class="section__header" style="margin-bottom: calc(1.4228rem + 1.3423vw);">
        {% render 'header', section: section %}
      </div>
    {% endif %}
    <div class="content__multi-content d-flex f-wrap gap-custom" style="--gap-custom: {{ section_st.gap_custom }};">
      {% content_for 'blocks' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Multi Content",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section color",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "defaul",
      "options": [
        {
          "value": "defaul",
          "label": "Defaul"
        },
        {
          "value": "fluid-container",
          "label": "Fluid Container"
        },
        {
          "value": "stretch-width",
          "label": "Stretch Width"
        },
        {
          "value": "full-width",
          "label": "Full Width"
        }
      ]
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Subheading</p>"
    },
    {
      "type": "select",
      "id": "header_size",
      "label": "Header size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "type": "select",
      "id": "txt_align",
      "label": "Text Align",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reverse_content",
      "label": "Reverse content order",
      "default": false,
      "visible_if": "{{ section.settings.heading != blank and section.settings.subheading != blank }}"
    },
    {
      "type": "header",
      "content": "Settings"
    },
    {
      "type": "range",
      "id": "gap_custom",
      "label": "Gap between",
      "default": 15,
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "height_img_mobile",
      "label": "Height mobile",
      "default": 300,
      "min": 300,
      "max": 500,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "height_img_desktop",
      "label": "Height desktop",
      "default": 500,
      "min": 500,
      "max": 800,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "radius_image",
      "label": "Corner radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0
    },

    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "section_pt",
      "label": "Top",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_pb",
      "label": "Bottom",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "_group-media-content"
    }
  ],
  "presets": [
    {
      "name": "Multi Content",
      "blocks": [
        {
          "type": "_group-media-content",
          "blocks": [
            {
              "type": "title"
            },
            {
              "type": "description"
            },
            {
              "type": "button"
            }
          ]
        },
        {
          "type": "_group-media-content",
          "blocks": [
            {
              "type": "title"
            },
            {
              "type": "description"
            },
            {
              "type": "button"
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
