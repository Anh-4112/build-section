{{ 'scrolling-text.css' | asset_url | stylesheet_tag }}

{% liquid
  assign section_st = section.settings
%}

{% capture style %}
    --section-pt: {{ section_st.section_pt }}; --section-pb: {{ section_st.section_pb }};
{% endcapture %}

{% capture style_marquee %}
    --speed: {{ section_st.speed }}s;{% if section_st.direction == 'left_to_right' %} --direction: 100%;{% else %} --direction: -100%;{% endif %}
{% endcapture %}

<section class="section__scrolling-text section__py color-{{ section_st.color_scheme }} gradient" style="{{ style | strip }}">
  <div class="{{ section_st.section_width }}">
    <div class="marquee d-flex overflow-hidden {% if section_st.direction == 'left_to_right' %} jc-end{% endif %}">
      {% for i in (0..15) %}
        <div class="marquee-animation d-flex" style="{{ style_marquee | strip }}">
          {% for block in section.blocks %}
            {% assign blocks_st = block.settings %}
            <div
              class="marquee-item d-flex ai-center gap-custom{% if section_st.layout_items == 'vertical' %} column{% endif %}{% if section_st.direction == 'left_to_right' %} ml-custom{% else %} mr-custom{% endif %}"
              style="--gap-custom: {{ section_st.space_between_img_and_text }};{% if section_st.direction == 'left_to_right' %} --ml-custom: {{ section_st.space_between_items }};{% else %} --mr-custom: {{ section_st.space_between_items }};{% endif %}"
            >
              {% if section_st.show_image == true %}
                <div
                  class="marquee-media w-custom ratio-{{ section_st.image_ratio }} rounded-custom overflow-hidden "
                  style="--w-custom: {{ section_st.image_width }}; --rounded-custom: {{ section_st.image_rounded }};"
                >
                  {% if blocks_st.image != blank %}
                    <img
                      class="img-cover"
                      src="{{ blocks_st.image | image_url }}"
                      alt="Image"
                      width="100%"
                      height="100%"
                    >
                  {% else %}
                    {% render 'image-clone' %}
                  {% endif %}
                </div>
              {% endif %}
              {% if blocks_st.text != blank %}
                <div class="marquee-info txt-nowrap subheading-{{ section_st.txt_size }}">
                  {{ blocks_st.text }}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Scrolling Text",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section color",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "defaul",
      "options": [
        {
          "value": "defaul",
          "label": "Defaul"
        },
        {
          "value": "fluid-container",
          "label": "Fluid Container"
        },
        {
          "value": "stretch-width",
          "label": "Stretch Width"
        },
        {
          "value": "full-width",
          "label": "Full Width"
        }
      ]
    },

    {
      "type": "header",
      "content": "Scrolling settings"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show image",
      "default": true
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "default": "right_to_left",
      "options": [
        {
          "value": "right_to_left",
          "label": "Right to Left"
        },
        {
          "value": "left_to_right",
          "label": "Left to Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Speed",
      "min": 3,
      "max": 30,
      "step": 1,
      "unit": "s",
      "default": 10
    },
    {
      "type": "select",
      "id": "layout_items",
      "label": "Layout items",
      "default": "horizontal",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "vertical",
          "label": "Vertical"
        }
      ]
    },
    {
      "type": "range",
      "id": "space_between_items",
      "label": "Space between items",
      "min": 30,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "space_between_img_and_text",
      "label": "Space between image and text",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 15
    },

    {
      "type": "header",
      "content": "Image settings"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Width",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 100
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Ratio",
      "default": "adapt",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "portrait",
          "label": "Portrait (3:4)"
        },
        {
          "value": "landscape",
          "label": "Landscape (4:3)"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_rounded",
      "label": "Rounded",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },

    {
      "type": "header",
      "content": "Text settings"
    },
    {
      "type": "select",
      "id": "txt_size",
      "label": "Text size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },

    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "section_pt",
      "label": "Top",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_pb",
      "label": "Bottom",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "scrolling_text_item",
      "name": "Scrolling Text Item",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Scrolling Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scrolling Text",
      "blocks": [
        {
          "type": "scrolling_text_item"
        },
        {
          "type": "scrolling_text_item"
        },
        {
          "type": "scrolling_text_item"
        }
      ]
    }
  ]
}
{% endschema %}
