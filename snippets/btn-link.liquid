<a
    href="{{ btn_link |  default: '#!' }}"
    {% if open_new_tab %}
        target="_blank"
        rel="noopener noreferrer"
    {% endif %}
    class="btn-link{% if btn_link == blank %} not-allowed{% endif %}"
    style="font-size: 1.6rem; font-weight: 600;"
>
    {{ btn_name |  default: 'Button Link' }}
</a>