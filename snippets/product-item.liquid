{{ 'product-item.css' | asset_url | stylesheet_tag }}
{{ 'hover.css' | asset_url | stylesheet_tag }}
{{ 'tooltip.css' | asset_url | stylesheet_tag }}

{% liquid
  assign theme_st = settings
%}

<div class="product__item">
  <div
    class="product-media wrapper-hover overflow-hidden relative ratio-{{ theme_st.product_ratio_image }} rounded-custom"
    style="--rounded-custom: {{ theme_st.product_radius_image }};"
  >
    <a class="product-media--image d-block h-full" href="{{ product.url | default: '#' }}">
      {% if product.featured_image != blank %}
        <img
          class="image-main hover-hidden img-cover d-block"
          src="{{ product.featured_image | image_url }}"
          alt="{{ product.title }}"
          width="100%"
          height="100%"
        >
      {% else %}
        {% render 'image-clone' %}
      {% endif %}
      {% if product.featured_image != blank %}
        <img
          class="image-hover hover-appear img-cover d-block absolute top-0 left-0 opacity-0"
          src="{{ product.media[1] | image_url }}"
          alt="{{ product.title }}"
          width="100%"
          height="100%"
        >
      {% endif %}
    </a>
    <div
      class="wrapper-icon hover-appear hover-left absolute z-1 right-10 right-md-0 d-flex column gap-10"
      style="top:calc(0.8557rem + 0.3356vw);"
    >
      <div class="icon-wishlist btn-primary d-flex h-40 w-40 middle-center rounded-50p wrapper-tooltip">
        <svg width="14" height="14" viewBox="0 0 20 17" fill="none" xmlns="http://www.w3.org/2000/svg">
