    </div>
    {% comment %}
      <div class="btn-add-cart hover-appear hover-up h-fit absolute bottom-0 right-0 left-0 z-1">
          <button class="d-block pointer btn-primary overflow-hidden rounded-35 py-20 mx-auto{% if product.featured_image == blank %} not-allowed{% endif %}" style="width: 80%;">
              Add to Cart
          </button>
      </div>
    {% endcomment %}
  </div>
  <div
    class="product__info d-flex column py-custom px-custom ai-{{ theme_st.product_alignment_content }}"
    style="--py-custom: {{ theme_st.product_padding_block }}; --px-custom: {{ theme_st.product_padding_inline }};"
  >
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'product_vendor' %}
          <div
            class="product__info-vendor mb-custom"
            style="--mb-custom: {{ block.settings.product_spacing_vendor }};"
          >
            {{ product.vendor | default: 'Vendor Name' }}
          </div>
        {% when 'product_name' %}
          <a
            href="{{ product.url | default: '#' }}"
            class="product__info-name typography-info d-block mb-custom"
            style="--mb-custom: {{ block.settings.product_spacing_name }};"
          >
            {{ product.title | default: 'Product Name' }}
          </a>
        {% when 'product_price' %}
          <div
            class="product__info-price mb-custom"
            style="--mb-custom: {{ block.settings.product_spacing_price }};"
          >
            {{ product.price | default: '0' | money }}
          </div>
        {% when 'product_rate' %}
          {%- if product.metafields.reviews.rating.value != blank -%}
            {% liquid
              assign rating_decimal = 0
              assign rating_decimal = product.metafields.reviews.rating.value | plus: 1
              assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
              if decimal >= 0.3 and decimal <= 0.7
                assign rating_decimal = 0.5
              elsif decimal > 0.7
                assign rating_decimal = 1
              endif
              assign rating_integer = product.metafields.reviews.rating.value.rating | floor
            %}
          {% endif %}
          <div
            class="product__info-rate relative mb-custom"
            style="line-height: 0; --mb-custom: {{ block.settings.product_spacing_rate }};"
          >
            <svg width="78" height="14" viewBox="0 0 78 14">
              <use href="#icon-rate-grey"></use>
            </svg>
            <div
              class="d-inline-flex absolute gap-2 z-1 color-rate"
              style="--color-rate: {{ color_rate }}; height: 14px; top: 0; left: 0;"
            >
              {% for i in (1..rating_integer) %}
                <svg width="14" height="14" viewBox="0 0 14 14">
                  <use href="#icon-rate"></use>
                </svg>
              {% endfor %}
              {% if rating_decimal == 0.5 %}
                <svg width="20" height="20" viewBox="0 0 14 14">
                  <use href="#icon-rate-half"></use>
                </svg>
              {% endif %}
            </div>
          </div>
        {% when 'product_variant' %}
          <div
            class="product__info-variant mb-custom"
            style="--mb-custom: {{ block.settings.product_spacing_variant }};"
          >
            {% for product_option in product.options_with_values %}
              {% if product_option.name == 'Color' %}
                {% for value in product_option.values %}
                  <span
                    class="variant-wrapper d-inline-flex h-19 w-19 content-center bor bor-1 bor-color-custom rounded-50p"
                    style="--border-color-custom: #a1a1a1;"
                  >
                    <span
                      class="variant-inner d-block h-14 w-14 rounded-50p overflow-hidden "
                      style="background-color: {{ value.swatch.color }};"
                    ></span>
                  </span>
                {% endfor %}
              {% endif %}
            {% endfor %}
          </div>
      {% endcase %}
    {% endfor %}
  </div>
</div>
