{% liquid
  assign section_st = section.settings

  assign ratio_image = section_st.ratio_image
  if ratio_image == 'adapt'
    assign ratio_image = ''
  elsif ratio_image == 'square'
    assign ratio_image = 'ratio-square'
  else
    assign ratio_image = 'ratio-portrait'
  endif
%}

<a
  class="collection__item wrapper-hover d-block{% if section_st.position_content == 'overlay_image' %} relative h-full{% endif %}"
  href="{{ collection.url | default: '#' }}"
>
  <div class="collection__item-media h-full rounded-20 overflow-hidden {{ ratio_image }}">
    {% if collection.image != blank %}
      <img
        class="img-cover hover-zoom-out d-block"
        src="{{ collection.image | image_url }}"
        alt="{{ collection.title }}"
        width="100%"
        height="100%"
      >
    {% else %}
      {% render 'image-clone' %}
    {% endif %}
  </div>
  <div
    class="
      collection__item-info typography-info text-{{ section_st.content_alignment }}
      {% if section_st.position_content == 'overlay_image' %} absolute left-10p bottom-1p right-10p{% endif %}
      {% if section_st.position_content == 'below_image' %} mt-20{% endif %}
    "
  >
    <span
      class="collection-name-wrapper d-inline-block"
      product-count="{{ collection.products_count |  default: 0 }}"
      show-product-count="{{ section_st.show_product_count }}"
    >
      <span class="collection-name btn-link">
        {{ collection.title | default: 'Collection Name' }}
      </span>
    </span>
  </div>
</a>
