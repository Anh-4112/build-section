{{ 'header.css' | asset_url | stylesheet_tag }}
{% liquid
  assign section_st = section.settings
%}
<div class="block__header">
  <div class="block__header-text d-flex{% if section_st.reverse_content == true %} column-reverse{% else %} column{% endif %} text-{{ section_st.text_align }}">
    {% if section_st.heading != blank %}
      <h2 class="header__text--heading heading-{{ section_st.header_size }}">
        {{ section_st.heading }}
      </h2>
    {% endif %}

    {% if section_st.subheading != blank %}
      <h3 class="header__text--subheading subheading-{{ section_st.header_size }}">
        {{ section_st.subheading }}
      </h3>
    {% endif %}
  </div>
</div>
