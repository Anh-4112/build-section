<a 
    href="{{ btn_link |  default: '#!' }}"
    {% if open_new_tab %}
        target="_blank"
        rel="noopener noreferrer"
    {% endif %}
    class="w-190 h-50 rounded-35 d-inline-flex content-center bg-black color-white{% if btn_link == blank %} not-allowed{% endif %}"
    style="font-size: 1.6rem; font-weight: 600;"
>
    {{ btn_name |  default: 'Button Primary' }}
</a>