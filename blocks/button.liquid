{% liquid
    assign block_st = block.settings
%}

{% capture style %}
    --mt-custom: {{ block_st.spacing_top }}; --mb-custom: {{ block_st.spacing_bottom }};
{% endcapture %}

<div 
    class="block__button w-fit mt-custom mb-custom"
    style="{{ style }}"
    {{ block.shopify_attributes }}
>
    {% if block_st.btn_type_block == 'primary' %}
        {% 
            render 'btn-primary',
            btn_name : block_st.button_name,
            btn_link: block_st.link_button,
            open_new_tab: block_st.open_new_tab
        %}
    {% elsif block_st.btn_type_block == 'outline' %}
        {% 
            render 'btn-outline',
            btn_name : block_st.button_name,
            btn_link: block_st.link_button,
            open_new_tab: block_st.open_new_tab
        %}
    {% elsif block_st.btn_type_block == 'link' %}
        {% 
            render 'btn-link', 
            btn_name : block_st.button_name,
            btn_link: block_st.link_button,
            open_new_tab: block_st.open_new_tab
        %}
    {% endif %}
</div>

{%  schema  %}
{
    "name": "Button",
    "settings": [
        {
            "type": "text",
            "id": "button_name",
            "label": "Button text",
            "default": "Button"
        },
        {
            "type": "url",
            "id": "link_button",
            "label": "Link Button"
        },
        {
            "type": "select",
            "id": "btn_type_block",
            "label": "Type",
            "default": "primary",
            "options": [
                {
                    "value": "primary",
                    "label": "Primary"
                },
                {
                    "value": "outline",
                    "label": "Outline"
                },
                {
                    "value": "link",
                    "label": "Link"
                }
            ]
        },
        {
            "type": "checkbox",
            "id": "open_new_tab",
            "label": "Open in new tab",
            "default": false
        },

        {
            "type": "header",
            "content": "Spacing"
        },
        {
            "type": "range",
            "id": "spacing_top",
            "label": "Spacing top",
            "default": 0,
            "min": 0,
            "max": 50,
            "step": 1
        },
        {
            "type": "range",
            "id": "spacing_bottom",
            "label": "Spacing bottom",
            "default": 16,
            "min": 0,
            "max": 50,
            "step": 1
        }
    ],
    "presets": [
        {
            "name": "Button"
        }
    ]
}
{% endschema %}