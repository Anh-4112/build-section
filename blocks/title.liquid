{% liquid
  assign block_st = block.settings
%}

{% capture style %}
    --mt-custom: {{ block_st.spacing_top }}; --mb-custom: {{ block_st.spacing_bottom }};
{% endcapture %}

<div
  class="block__title w-fit fs-custom fw-custom mt-custom mb-custom {{ block_st.text_transform }}"
  style="{{ style | strip }}; --fs-custom: {{ block_st.font_size }}; --fw-custom: {{ block_st.font_weight }};"
  {{ block.shopify_attributes }}
>
  {{ block_st.content }}
</div>

{% schema %}
{
  "name": "Title",
  "settings": [
    {
      "type": "text",
      "id": "content",
      "label": "Content",
      "default": "<p>Text Title</p>"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text transform",
      "default": "uppercase",
      "options": [
        {
          "value": "unset",
          "label": "Unset"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ]
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "default": 36,
      "min": 10,
      "max": 54,
      "step": 1
    },
    {
      "type": "range",
      "id": "font_weight",
      "label": "Font weight",
      "default": 500,
      "min": 100,
      "max": 900,
      "step": 100
    },

    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "Spacing top",
      "default": 0,
      "min": 0,
      "max": 50,
      "step": 1
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "Spacing bottom",
      "default": 16,
      "min": 0,
      "max": 50,
      "step": 1
    }
  ],
  "presets": [
    {
      "name": "Title"
    }
  ]
}
{% endschema %}
